# ============================================================
# Copia este archivo como ".env" y completa tus datos reales.
# NUNCA subas el archivo ".env" real a GitHub.
# ============================================================

# --- Neon PostgreSQL ---
# La sacas del dashboard de Neon > tu proyecto > "Connection string"
DATABASE_URL=postgresql://USUARIO:PASSWORD@ENDPOINT.neon.tech/NOMBRE_DB?sslmode=require

# --- Servidor ---
PORT=3000
BASE_URL=http://localhost:3000
# En producción usar la URL de Render, ej: https://api.accsalcrison.cl

# --- Transbank Webpay Plus ---
# Deja TBK_ENV vacío o en "test" mientras pruebas (usa credenciales de integración automáticamente)
# Cuando Transbank te apruebe como comercio, pon TBK_ENV=production y completa las 2 variables siguientes
TBK_ENV=test
TBK_COMMERCE_CODE=
TBK_API_KEY=

# --- Chilexpress API Envíos ---
# CHILEXPRESS_ENV=test mientras pruebas, CHILEXPRESS_ENV=production cuando tengas credenciales reales
CHILEXPRESS_ENV=test
CHILEXPRESS_SUBSCRIPTION_KEY=TU_SUBSCRIPTION_KEY_AQUI
CHILEXPRESS_TCC=TU_TCC_AQUI

# --- Datos de tu tienda (origen de los envíos Chilexpress) ---
TIENDA_NOMBRE=Alcrison Accesorios
TIENDA_TELEFONO=+56977137165
TIENDA_EMAIL=Alcrison@gmail.com
TIENDA_CALLE=Av. Santa María
TIENDA_NUMERO=803
TIENDA_CALLE2=
# Coverage code de tu comuna — consúltalo en la API de Chilexpress una vez suscrito
TIENDA_COVERAGE_CODE=PMON
